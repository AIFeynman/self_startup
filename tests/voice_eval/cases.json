{
  "cases": [
    {"id": "chat-1", "kind": "寒暄", "text": "喂，你听得到吗？", "expect": "fast"},
    {"id": "chat-2", "kind": "寒暄", "text": "今天真是有点累。", "expect": "fast"},
    {"id": "chat-3", "kind": "寒暄", "text": "谢谢，这样就差不多了。", "expect": "fast"},
    {"id": "chat-4", "kind": "寒暄", "text": "你好，我们开始吧。", "expect": "fast"},
    {"id": "chat-5", "kind": "寒暄", "text": "好的，你说得对，我记一下。", "expect": "fast"},

    {"id": "ctl-1", "kind": "控制", "text": "刚才那句再说一遍。", "expect": "fast", "context": ["【你刚说过】先把实时接入做稳，问答放到后面。"]},
    {"id": "ctl-2", "kind": "控制", "text": "你说慢一点，我没跟上。", "expect": "fast", "context": ["【你刚说过】第一步做中转，第二步接工具，第三步跑评测。"]},
    {"id": "ctl-3", "kind": "控制", "text": "好了吗？", "expect": "get_thinking_status", "context": ["【后台状态】慢思考正在想：这周先推哪件事。"]},
    {"id": "ctl-4", "kind": "控制", "text": "想得怎么样了？", "expect": "get_thinking_status", "context": ["【后台状态】慢思考正在想：这周先推哪件事。"]},
    {"id": "ctl-5", "kind": "控制", "text": "算了，别想了。", "expect": "cancel_thinking", "context": ["【后台状态】慢思考正在想：这周先推哪件事。"]},
    {"id": "ctl-6", "kind": "控制", "text": "不用查了，这个先放一放。", "expect": "cancel_thinking", "context": ["【后台状态】慢思考正在想：语音评测怎么做。"]},
    {"id": "ctl-7", "kind": "控制", "text": "对了，周四我要出差，这个你也考虑一下。", "expect": "update_thinking", "context": ["【后台状态】慢思考正在想：这周先推哪件事。"]},
    {"id": "ctl-8", "kind": "控制", "text": "今天外面下雨了，好烦。", "expect": "fast", "context": ["【后台状态】慢思考正在想：这周先推哪件事。"]},

    {"id": "fact-1", "tts": "say", "kind": "常识", "text": "TTS 是什么的缩写？", "expect": "fast", "terms": ["TTS"]},
    {"id": "fact-2", "kind": "常识", "text": "一分钟有多少秒？", "expect": "fast"},
    {"id": "fact-3", "tts": "say", "kind": "常识", "text": "HTTP 是什么意思？", "expect": "fast", "terms": ["HTTP"]},
    {"id": "fact-4", "kind": "常识", "text": "法国的首都是哪里？", "expect": "fast"},
    {"id": "fact-5", "kind": "常识", "text": "二的十次方是多少？", "expect": "fast"},

    {"id": "mine-1", "kind": "资料", "text": "我之前有没有记过关于强化学习的笔记？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-2", "kind": "资料", "text": "上周的复盘里我说了什么问题？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-3", "kind": "资料", "text": "我今天的计划里还有哪些事没做？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-4", "kind": "资料", "text": "你看一下知识库里关于语音模型的调研，结论是什么？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-5", "kind": "资料", "text": "我学到第几章了？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-6", "kind": "资料", "text": "我们代码里语音转写的超时设的是多少？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-7", "kind": "资料", "text": "我上次说想读的那篇论文叫什么来着？", "expect": "ask_claude", "must_not_invent": true},
    {"id": "mine-8", "kind": "资料", "text": "这个月的新模型有哪些值得关注？", "expect": "ask_claude"},

