    {"id": "adv-7", "kind": "建议", "text": "不要给我列清单，就告诉我今天最该做的一件事。", "expect": "ask_claude", "keep": ["不要", "清单"]},
    {"id": "adv-8", "kind": "建议", "text": "预算不超过两千，不考虑云服务，语音模型应该怎么选？", "expect": "ask_claude", "keep": ["两千", "云服务"]},

    {"id": "term-1", "kind": "术语", "text": "Claude Code 和 Codex 各自适合做什么？", "expect": "ask_claude", "terms": ["Claude Code", "Codex"]},
    {"id": "term-2", "tts": "say", "kind": "术语", "text": "WebSocket 和 WebRTC 哪个延迟低？", "expect": "any", "terms": ["WebSocket", "WebRTC"]},
    {"id": "term-3", "kind": "术语", "text": "RAG 的召回率要怎么评估？", "expect": "any", "terms": ["RAG"]},
    {"id": "term-4", "kind": "术语", "text": "帮我比较一下 Kokoro 和 Whisper 分别在链路里做什么。", "expect": "any", "terms": ["Kokoro", "Whisper"]},

    {"id": "noise-1", "kind": "噪声", "text": "嗯。", "expect": "silent"},
    {"id": "noise-2", "kind": "噪声", "text": "帮我想想这周先推哪件事。", "expect": "ask_claude", "mix": "noise"},
    {"id": "noise-3", "kind": "噪声", "text": "你晚上想吃什么，要不要点外卖？", "expect": "silent", "mix": "faint"}
  ],
