{
  "version": "2026-11-02.1",
  "note": "论文脉络库分类体系。一篇论文 = 类型（单选）+ 主方向（1 个二级类）+ 副方向（0–2 个二级类）+ 检索标签（problem / method / bench / base）+ 中文一句话 + builds_on（只能从它的库内参考文献里选）。二级类 code 全局唯一。",
  "kinds": [
    {"code": "method", "name": "新方法", "desc": "提出新算法、损失、训练技巧或架构"},
    {"code": "model", "name": "模型 / 技术报告", "desc": "发布模型或技术报告；报告里的新方法写进 method 标签"},
    {"code": "survey", "name": "综述", "desc": "系统梳理一个方向"},
    {"code": "benchmark", "name": "评测基准", "desc": "提出评测集、评测方法或排行榜（顺带评一批模型也算）"},
    {"code": "dataset", "name": "训练数据", "desc": "训练 / 微调 / 偏好数据集或数据构造方法"},
    {"code": "empirical", "name": "实验分析", "desc": "不提新方法，靠大规模实验得出发现：scaling law、某方法是否真的有效、消融研究"},
    {"code": "theory", "name": "理论", "desc": "以证明或理论分析为主"},
    {"code": "system", "name": "系统 / 工程", "desc": "训练 / 推理框架、分布式、算子"},
